@article{lebechecNotebookOpenScience2024,
  title      = {Notebook and {{Open}} Science : Toward More {{FAIR}} Play},
  shorttitle = {Notebook and {{Open}} Science},
  author     = {Le B{\'e}chec, Mariannig and {Gruson-Daniel}, C{\'e}lya and Lascombes, Cl{\'e}mence and Schultz, {\'E}milien},
  year       = 2024,
